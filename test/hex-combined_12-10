#!/bin/bash
#
# The same log and the same damage as combined_12-10 -- one segment
# deleted, one corrupted, one truncated -- read as hexadecimal rather
# than as the ASCII the rest of the suite stores.
#
# Having both means the suite covers each of tcslog-dump's renderings
# end to end, and comparing the two expected files shows what the flag
# changes and what it does not: the payload lines differ, and every
# segment header, loss notice and total is the same in both.
#
# Generate segment files as follows:
# o Variable length data records, 12 bytes each
# o Data section size, in bytes: 10
#
# Number of records: 10
# Delete segment file 2, corrupt 6, truncate 10

set -eu

PFX=pfx-
SFX=.log

bin="$(dirname "$0")/../bin"

FORMAT="variable-simple:12"
DATA_SIZE="10"
NUMBER="10"
DELETE="2"
CORRUPT="6"
TRUNCATE="10"

$bin/error-recovery-common \
    -e "hex-combined_12-10.expected" \
    -f "$FORMAT" \
    -s "$DATA_SIZE" \
    -n "$NUMBER" \
    -d "$DELETE" \
    -c "$CORRUPT" \
    -t "$TRUNCATE" \
    -H \
    "$@"
