#!/bin/bash
#
# A segment file padded past the max_size stored in its own header,
# which the spec forbids. The reader must refuse it rather than read data
# beyond the size the writer declared.
#
# This runs tcslog-gen to generate segment files. It then deletes and
# corrupts them in various ways and uses tcslog-dump to see whether
# error recovery works.

set -eu

PFX=pfx-
SFX=.log

test="$(dirname "$0")"

FORMAT="variable-simple:12"
DATA_SIZE="10"
NUMBER="5"
OVERSIZE="2"

$test/error-recovery-common \
    -e "oversize_12-10.expected" \
    -f "$FORMAT" \
    -s "$DATA_SIZE" \
    -n "$NUMBER" \
    -O "$OVERSIZE" \
    "$@"
