#!/bin/bash
#
# A single deleted segment file that held one whole data header and
# nothing else of the record it belonged to -- the one gap whose
# arithmetic settles where the next record's payload begins -- in the
# format that still cannot use it.
#
# Records are 8 payload bytes plus a 20-byte data header, so 28 bytes
# against a 24-byte data section. Record 1 therefore owes 4 bytes of
# file 2, leaving exactly 20: record 2's data header fills the rest of
# that file and its payload begins at the first byte of file 3. That is
# the geometry combined_12-10 recovers from in variable-simple, where
# the surviving file's `remaining` field is the whole of the lost data
# header. Here the header also carries a timestamp and a record count,
# which nothing on disk rebuilds, so record 2 must be given up rather
# than handed back with invented metadata.
#
# This runs tcslog-gen to generate segment files. It then deletes and
# corrupts them in various ways and uses tcslog-dump to see whether
# error recovery works.

set -eu

PFX=pfx-
SFX=.log

bin="$(dirname "$0")/../bin"

FORMAT="variable-tsrc:8"
DATA_SIZE="24"
NUMBER="6"
DELETE="2"

$bin/error-recovery-common \
    -e "tsrc-lost-header_8-24.expected" \
    -f "$FORMAT" \
    -s "$DATA_SIZE" \
    -n "$NUMBER" \
    -d "$DELETE" \
    "$@"
