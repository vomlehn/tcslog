#!/bin/bash
#
# Corrupts a segment file's header magic instead of deleting the file.
# The segment cannot be opened, so the reader steps over it exactly as
# it would a missing file and the sequence gap still accounts for it.
#
# This runs tcslog-gen to generate segment files. It then deletes and
# corrupts them in various ways and uses tcslog-dump to see whether
# error recovery works.

set -eu

PFX=pfx-
SFX=.log

test="$(dirname "$0")"

FORMAT="variable-simple:12"
DATA_SIZE="10"
NUMBER="5"
CORRUPT="2"

$test/error-recovery-common \
    -e "corrupt_12-10.expected" \
    -f "$FORMAT" \
    -s "$DATA_SIZE" \
    -n "$NUMBER" \
    -c "$CORRUPT" \
    "$@"
