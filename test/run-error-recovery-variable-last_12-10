#!/bin/bash
#
# Loses the final segment file while a record is still running into it.
# Records are 16 bytes against a 10-byte data section, so the last
# record's tail lives in the last segment; removing it must be reported
# as a truncated read rather than a clean end of log.
#
# This runs tcslog-gen to generate segment files. It then deletes and
# corrupts them in various ways and uses tcslog-dump to see whether
# error recovery works.

set -eu

PFX=pfx-
SFX=.log

test="$(dirname "$0")"

FORMAT="variable-simple:12"
DATA_SIZE="10"
NUMBER="3"
DELETE="last"

$test/error-recovery-common \
    -e "variable-last_12-10.expected" \
    -f "$FORMAT" \
    -s "$DATA_SIZE" \
    -n "$NUMBER" \
    -d "$DELETE" \
    "$@"
