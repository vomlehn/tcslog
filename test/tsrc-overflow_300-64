#!/bin/bash
#
# Reads variable-tsrc records larger than tcslog-dump's fixed 256-byte
# buffer. The overflow count covers payload only, so the reader must
# report the same 256 bytes captured here as in the variable-simple
# case, with the 20-byte data header accounted for separately rather
# than charged against the caller's buffer.
#
# No segment file is damaged: the recovery being checked is the one a
# caller's undersized buffer forces.

set -eu

PFX=pfx-
SFX=.log

test="$(dirname "$0")"

FORMAT="variable-tsrc:300"
DATA_SIZE="64"
NUMBER="3"

$test/error-recovery-common \
    -e "tsrc-overflow_300-64.expected" \
    -f "$FORMAT" \
    -s "$DATA_SIZE" \
    -n "$NUMBER" \
    "$@"
