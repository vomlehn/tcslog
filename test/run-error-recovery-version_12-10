#!/bin/bash
#
# A segment file stamped with a major version this build cannot read.
# The reader must refuse it and account for it as a lost segment rather
# than read it with the wrong layout.
#
# This runs tcslog-gen to generate segment files. It then deletes and
# corrupts them in various ways and uses tcslog-dump to see whether
# error recovery works.

set -eu

PFX=pfx-
SFX=.log

test="$(dirname "$0")"

FORMAT="variable-simple:12"
DATA_SIZE="10"
NUMBER="5"
VERSION="2"

$test/error-recovery-common \
    -e "version_12-10.expected" \
    -f "$FORMAT" \
    -s "$DATA_SIZE" \
    -n "$NUMBER" \
    -V "$VERSION" \
    "$@"
