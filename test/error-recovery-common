#!/bin/bash
#
# This runs tcslog-gen to generate segment files. It then deletes and
# corrupts them in various ways and uses tcslog-dump to see whether
# error recovery works.
# working correctly. It's also helpful in checking out tcslog-dump.

set -eu

# Cleanup runs from a single EXIT trap so that -k, which is not known
# until the options are parsed, can spare the segment files.
keep_tmp=0
actual_file=""
expected_cmp=""
actual_cmp=""
TMP_DIR=$(mktemp -d -t tcslog.XXXXXXXXXX)
cleanup() {
    rm -f "$actual_file" "$expected_cmp" "$actual_cmp"
    if [ $keep_tmp -ne 0 ]; then
        echo "Temporary directory kept: $TMP_DIR"
    else
        rm -rf "$TMP_DIR"
    fi
}
trap cleanup EXIT
PFX=pfx-
SFX=.log

hexdump_enabled=0
generate=0
delete_indices_str=""
expected_file=""
FORMAT="variable-simple:0..10"
number=20
data_size=17
usage() {
cat <<-EOF
Usage: $0 -e <expected-file> [-g] [-k] [-x] [-d \"idx1 idx2 ...\"] [-f spec] [-n <count>] [-s <bytes>] [-h]
-d idx1 idx2 ...  Indices of files to delete, starting at 1
-f spec           Data format in log file
-g                Overwrite the expected file with this run's output
                  instead of comparing against it. Timestamps are
                  masked with X so the file stays reproducible.
-k                Print the temporary directory holding the segment
                  files and keep it instead of deleting it on exit.
-n count          Number of records to write
-s size           Maximum of bytes in the data section
-x                Perform a hex dump of the output files after deletion
EOF
    exit 1
}
require_uint() {
    local flag="$1" val="$2"
    if ! [[ "$val" =~ ^[0-9]+$ ]]; then
        echo "Option -$flag requires an unsigned integer, got: '$val'" 1>&2
        exit 1
    fi
}
while getopts ":gkxhd:e:f:n:s:" opt; do
    case "$opt" in
        d) delete_indices_str="$OPTARG" ;;
        e) expected_file="expected/$OPTARG" ;;
        f) FORMAT="$OPTARG" ;;
        g) generate=1 ;;
        h) usage ;;
        k) keep_tmp=1 ;;
        n) require_uint n "$OPTARG"; number="$OPTARG" ;;
        s) require_uint s "$OPTARG"; data_size="$OPTARG" ;;
        x) hexdump_enabled=1 ;;
        :) echo "Option -$OPTARG requires an argument" 1>&2; usage ;;
        \?) echo "Unknown option: -$OPTARG" 1>&2; usage ;;
    esac
done
shift $((OPTIND - 1))

if [ -z "$expected_file" ]; then
    echo "The -e <expected-file> option is required." 1>&2
    usage
fi
if [ ! -f "$expected_file" ] && [ $generate -eq 0 ]; then
    echo "Expected results file not found: $expected_file" 1>&2
    echo "Use -g to create it from this run's output." 1>&2
    exit 1
fi

read -r -a delete_indices <<< "$delete_indices_str"
for idx in "${delete_indices[@]}"; do
    if ! [[ "$idx" =~ ^[0-9]+$ ]]; then
        echo "Invalid index in -d list: '$idx' (must be a non-negative integer)" 1>&2
        exit 1
    fi
done

rm_seg() {
    local idx=$1
    shift 1
    local args="$@"
    echo "Remove segment file #$idx: $args"
    rm $args
}

# Reject a --format this script does not know about before spending a
# cargo build on it; tcslog-gen validates the full syntax itself.
case $FORMAT in
    *fixed*|*variable-simple*|*variable-tsrc*)
        ;;

    *)
        echo "Invalid format: $FORMAT" 1>&2
        exit 1
        ;;
esac

echo "Generating log in $TMP_DIR: prefix $PFX suffix $SFX"

cargo run -p tcslog-gen -- \
    --data-size $data_size \
    --format $FORMAT \
    --number $number \
    $TMP_DIR $PFX $SFX

declare -a files
files=($TMP_DIR/$PFX*$SFX)

if true; then # Remove this
    echo ">>>>>>>>>>>>>>>>>>>>>>> hexdumping files. REMOVE this code"
    for f in "${files[@]}"; do
        echo
        echo $f
        hexdump -C $f
    done
fi

if [ ${#delete_indices[@]} -gt 0 ]; then
    echo
    echo "Removing segment files"
    for num in "${delete_indices[@]}"; do
        idx=$((num - 1))
        rm_seg $num "${files[$idx]}"
    done
fi

if [ $hexdump_enabled -ne 0 ]; then
    echo
    echo Hexdump of segment files
    for f in ${files[@]}; do
        if [ -f $f ]; then
            echo $f:
            hexdump -C $f
        else
            echo $f: deleted
        fi
    done
fi

echo
echo tcslog-dump output

actual_file=$(mktemp)
expected_cmp=$(mktemp)
actual_cmp=$(mktemp)
cargo run --quiet -p tcslog-dump -- \
    "$TMP_DIR" "$PFX" "$SFX" > "$actual_file"
cat "$actual_file"

# The variable-tsrc format stamps each record with the wall-clock time,
# so the timestamp differs on every run and cannot be checked against a
# stored file. Blank it out on both sides before comparing; every other
# field, the record count included, is still compared exactly.
strip_timestamp() {
    sed 's/ts=[^,)]*/ts=<ignored>/g' "$1"
}

# Replace every character of each timestamp with an X, preserving its
# length, so a stored expected file shows where the timestamp sits
# without pinning a value that can never repeat. Each pass turns the
# first not-yet-masked character after "ts=" into an X and branches
# back, until the run of X reaches the ',' or ')' ending the field.
mask_timestamp() {
    sed ':a; s/\(ts=X*\)[^,)X]/\1X/; ta' "$1"
}

if [ $generate -ne 0 ]; then
    mask_timestamp "$actual_file" > "$actual_cmp"
    cp "$actual_cmp" "$expected_file"
    echo
    echo "GENERATED: $expected_file (timestamps masked with X)"
    exit 0
fi

strip_timestamp "$expected_file" > "$expected_cmp"
strip_timestamp "$actual_file" > "$actual_cmp"

echo
if diff -u "$expected_cmp" "$actual_cmp"; then
    echo "OK: dump output matches $expected_file (timestamps ignored)"
else
    echo "FAIL: dump output does not match $expected_file" 1>&2
    exit 1
fi
