#!/bin/bash
#
# This runs tcslog-gen to generate segment files. It then deletes and
# corrupts them in various ways and uses tcslog-dump to see whether
# error recovery works.
# working correctly. It's also helpful in checking out tcslog-dump.

set -eu

TMP_DIR=/tmp/t1
PFX=pfx-
SFX=.log

hexdump_enabled=0
delete_indices_str=""
expected_file=""
FORMAT="variable-simple:0..10"
number=20
data_size=17
usage() {
    echo "Usage: $0 -e <expected-file> [-x] [-d \"idx1 idx2 ...\"] [-f \"--format <spec>\"] [-n <count>] [-s <bytes>] [-h]" 1>&2
    exit 1
}
require_uint() {
    local flag="$1" val="$2"
    if ! [[ "$val" =~ ^[0-9]+$ ]]; then
        echo "Option -$flag requires an unsigned integer, got: '$val'" 1>&2
        exit 1
    fi
}
while getopts ":xhd:e:f:n:s:" opt; do
    case "$opt" in
        x) hexdump_enabled=1 ;;
        d) delete_indices_str="$OPTARG" ;;
        e) expected_file="expected/$OPTARG" ;;
        f) FORMAT="$OPTARG" ;;
        n) require_uint n "$OPTARG"; number="$OPTARG" ;;
        s) require_uint s "$OPTARG"; data_size="$OPTARG" ;;
        h) usage ;;
        :) echo "Option -$OPTARG requires an argument" 1>&2; usage ;;
        \?) echo "Unknown option: -$OPTARG" 1>&2; usage ;;
    esac
done
shift $((OPTIND - 1))

if [ -z "$expected_file" ]; then
    echo "The -e <expected-file> option is required." 1>&2
    usage
fi
if [ ! -f "$expected_file" ]; then
    echo "Expected results file not found: $expected_file" 1>&2
    exit 1
fi

read -r -a delete_indices <<< "$delete_indices_str"
for idx in "${delete_indices[@]}"; do
    if ! [[ "$idx" =~ ^[0-9]+$ ]]; then
        echo "Invalid index in -d list: '$idx' (must be a non-negative integer)" 1>&2
        exit 1
    fi
done

segment_file_header_len=45

rm_seg() {
    local idx=$1
    shift 1
    local args="$@"
    echo "Remove segment file #$idx: $args"
    rm $args
}

case $FORMAT in
    *fixed*)
        data_header_len=0
        ;;

    *variable-simple*)
        data_header_len=4;
        ;;

    *variable--tsrc*)
        data_header_len=$((4 + 8 + 8))
        ;;

    *)
        echo "Invalid format: $FORMAT" 1>&2
        exit 1
        ;;
esac

echo Removing any existing logs in $TMP_DIR
rm -rf $TMP_DIR
mkdir -p $TMP_DIR

echo "Generating log in $TMP_DIR: prefix $PFX suffix $SFX"

cargo run -p tcslog-gen -- \
    --data-size $data_size \
    --format $FORMAT \
    --number $number \
    $TMP_DIR $PFX $SFX

declare -a files
files=($TMP_DIR/$PFX*$SFX)

if true; then # Remove this
    echo ">>>>>>>>>>>>>>>>>>>>>>> hexdumping files. REMOVE this code"
    for f in "${files[@]}"; do
        echo
        echo $f
        hexdump -C $f
    done
fi

if [ ${#delete_indices[@]} -gt 0 ]; then
    echo
    echo "Removing segment files"
    for num in "${delete_indices[@]}"; do
        idx=$((num - 1))
        rm_seg $num "${files[$idx]}"
    done
fi

if [ $hexdump_enabled -ne 0 ]; then
    echo
    echo Hexdump of segment files
    for f in ${files[@]}; do
        if [ -f $f ]; then
            echo $f:
            hexdump -C $f
        else
            echo $f: deleted
        fi
    done
fi

echo
echo tcslog-dump output

actual_file=$(mktemp)
trap 'rm -f "$actual_file"' EXIT
cargo run --quiet -p tcslog-dump -- \
    "$TMP_DIR" "$PFX" "$SFX" > "$actual_file"
cat "$actual_file"

echo
if diff -u "$expected_file" "$actual_file"; then
    echo "OK: dump output matches $expected_file"
else
    echo "FAIL: dump output does not match $expected_file" 1>&2
    exit 1
fi
