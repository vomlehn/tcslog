#!/bin/bash
#
# Corrupts a segment file's header magic instead of deleting the file.
# The segment cannot be opened, so the reader steps over it exactly as
# it would a missing file and the sequence gap still accounts for it.
#
# Generate segment files as follows:
# o Variable size data records
# o Data record length, in bytes: 12
# o Data section size, in bytes: 10`
#
# Number of records: 5
#
# Expect raw number of segment files: 5
# Corrupted segment files: 2

set -eu

PFX=pfx-
SFX=.log

bin="$(dirname "$0")/../bin"

FORMAT="variable-simple:12"
DATA_SIZE="10"
NUMBER="5"
CORRUPT="2"

$bin/error-recovery-common \
    -e "corrupt_12-10.expected" \
    -f "$FORMAT" \
    -s "$DATA_SIZE" \
    -n "$NUMBER" \
    -c "$CORRUPT" \
    "$@"
