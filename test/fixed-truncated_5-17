#!/bin/bash
#
# A short data section in a fixed-length format, which has no per-record
# data header at all: there is no stored length for the reader to check,
# so resynchronizing rests entirely on remaining and sequence.
#
# This runs tcslog-gen to generate segment files. It then deletes and
# corrupts them in various ways and uses tcslog-dump to see whether
# error recovery works.

set -eu

PFX=pfx-
SFX=.log

test="$(dirname "$0")"

FORMAT="fixed:5"
DATA_SIZE="17"
NUMBER="20"
TRUNCATE="3"

$test/error-recovery-common \
    -e "fixed-truncated_5-17.expected" \
    -f "$FORMAT" \
    -s "$DATA_SIZE" \
    -n "$NUMBER" \
    -t "$TRUNCATE" \
    "$@"
