#!/bin/bash
#
# A short data section in the variable-tsrc format: the sequence stays
# intact, so the loss must be reported with a count of zero even though
# the format has the widest data header to resynchronize against.
#
# This runs tcslog-gen to generate segment files. It then deletes and
# corrupts them in various ways and uses tcslog-dump to see whether
# error recovery works.

set -eu

PFX=pfx-
SFX=.log

test="$(dirname "$0")"

FORMAT="variable-tsrc:10"
DATA_SIZE="24"
NUMBER="6"
TRUNCATE="2"

$test/error-recovery-common \
    -e "tsrc-truncated_10-24.expected" \
    -f "$FORMAT" \
    -s "$DATA_SIZE" \
    -n "$NUMBER" \
    -t "$TRUNCATE" \
    "$@"
