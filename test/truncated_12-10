#!/bin/bash
#
# Truncates a segment file's data section, leaving its header intact.
# The segment opens and its sequence is readable, so a record running
# off the short end is a truncation the sequence cannot explain: the
# reader must report it with a lost count of zero, a path no deletion
# test can reach.
#
# This runs tcslog-gen to generate segment files. It then deletes and
# corrupts them in various ways and uses tcslog-dump to see whether
# error recovery works.

set -eu

PFX=pfx-
SFX=.log

test="$(dirname "$0")"

FORMAT="variable-simple:12"
DATA_SIZE="10"
NUMBER="5"
TRUNCATE="2"

$test/error-recovery-common \
    -e "truncated_12-10.expected" \
    -f "$FORMAT" \
    -s "$DATA_SIZE" \
    -n "$NUMBER" \
    -t "$TRUNCATE" \
    "$@"
