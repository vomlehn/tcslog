#!/bin/bash
#
# This runs tcslog-gen to generate segment files. It then deletes and
# corrupts them in various ways and uses tcslog-dump to see whether
# error recovery works.
# working correctly. It's also helpful in checking out tcslog-dump.

set -eu

# Dumps a segment file's header, then its data section. The skip is
# SEGMENT_FILE_HEADER_LEN from tcslog::header; a smaller value would
# show the tail of the header as if it were payload.
#
# A refused header is not a failure here. These scenarios corrupt header
# magic on purpose, and tcslog-dumphdr exits non-zero when it will not
# read one -- which under `set -e` took the whole run down before the
# comparison it exists for, so -r and -x were unusable on exactly the
# scenarios they are most wanted for. The refusal is reported and the
# hexdump still runs, that being what shows the damage.
dumphdr() {
    (
        "$(dirname "$0")/tcslog-tool" tcslog-dumphdr "$@" ||
            echo "    (header refused, bytes follow)"
        hexdump -C --skip 53 "$@"
    )
}

# Cleanup runs from a single EXIT trap so that -k, which is not known
# until the options are parsed, can spare the segment files.
keep_tmp=0
actual_file=""
expected_cmp=""
actual_cmp=""
TMP_DIR=$(mktemp -d -t tcslog.XXXXXXXXXX)
cleanup() {
    rm -f "$actual_file" "$expected_cmp" "$actual_cmp"
    if [ $keep_tmp -ne 0 ]; then
        echo "Temporary directory kept: $TMP_DIR"
    else
        rm -rf "$TMP_DIR"
    fi
}

trap cleanup EXIT


PFX=pfx-
SFX=.log

# Run from the test directory, so that neither the expected files it
# holds nor the cargo invocations below depend on where the caller
# happened to be. This script lives in bin/ rather than beside the
# expected files, so the path is relative to its own directory rather
# than simply being it. Cargo needs this as much as the expected files
# do: it discovers both the workspace manifest and the
# `.cargo/config.toml` that supplies TIMER_RESOLUTION by walking up
# from the working directory, and --manifest-path covers only the
# first of those. No option to this script takes a path, so nothing is
# left behind pointing at the old directory.
cd "$(dirname "$0")/../test"

dumphdr_enabled=0
raw_dumphdr_enabled=0
generate=0
delete_indices_str=""
corrupt_indices_str=""
truncate_indices_str=""
version_indices_str=""
segid_indices_str=""
oversize_indices_str=""
expected_file=""
# --text unless -H asks for the hexadecimal rendering. Records are
# compared and stored as ASCII because that is the form a person reads:
# a failing diff of `#1 123` against `#1 124` says what went wrong,
# where `23 31 20 31 32 33` against `23 31 20 31 32 34` does not.
text_flag="--text"
# --verbose unless -q asks for the records alone. The captured output is
# what is compared, so this chooses what the stored file holds, not just
# what reaches the terminal.
verbose_flag="--verbose"
FORMAT="variable-simple:0..10"
number=20
data_size=17
sessions=1
usage() {
cat <<-EOF
Usage: $0 -e <expected-file> [-g] [-k] [-q] [-r] [-x] [-H] [-d \"idx1 idx2 ...\"] [-c \"idx ...\"] [-t \"idx ...\"] [-f spec] [-n <count>] [-s <bytes>] [-S <count>] [-h]
-c idx1 idx2 ...  Indices of files whose header magic to overwrite, so
                  the segment cannot be opened at all. Unlike -d the
                  file is still present, which is what a corrupted
                  rather than a lost segment looks like.
-d idx1 idx2 ...  Indices of files to delete, starting at 1
-f spec           Data format in log file
-I idx1 idx2 ...  Indices of files whose stored segment_id to alter so
                  it no longer matches the id in the file name, as a
                  renamed or copied segment file would not.
-H                Compare the hexadecimal rendering, dropping --text
                  from the tcslog-dump run. Records are otherwise
                  stored as ASCII, which is the form a failing diff can
                  be read in. The rendering is the only difference:
                  everything the reader reports about loss and recovery
                  is the same either way, which is what makes the two
                  comparable.
-g                Overwrite the expected file with this run's output
                  instead of comparing against it. Timestamps are
                  masked with X so the file stays reproducible.
-k                Print the temporary directory holding the segment
                  files and keep it instead of deleting it on exit.
-n count          Number of records to write
-q                Compare the records alone, dropping --verbose from the
                  tcslog-dump run. What is captured is what is
                  compared, so this chooses the form of the stored file
                  as well: the expected file becomes
                  <name>-records.expected rather than <name>.expected,
                  which lets both forms be kept and checked. The log is
                  generated and damaged identically either way, and the
                  generation output still reaches the terminal.
-r                Hexdump the raw input segment files before any are
                  deleted
-O idx1 idx2 ...  Indices of files to pad past their own stored
                  max_size, which the spec forbids a segment file from
                  exceeding.
-s size           Maximum of bytes in the data section
-S count          Number of generation passes to run into the same
                  directory, each of which starts a new session. The
                  reader must end one session before reading the next.
-t idx1 idx2 ...  Indices of files to truncate to half their data
                  section, leaving the header intact. The segment still
                  opens and its sequence is still readable, so a record
                  running off its short end is a truncation with no
                  sequence gap.
-V idx1 idx2 ...  Indices of files whose stored version to set to a
                  major this build cannot read.
-x                Perform a hex dump of the output files after deletion

In every index list, the word "last" stands for the highest-numbered
segment file, whose index depends on the format and sizes in use.
EOF
    exit 1
}
require_uint() {
    local flag="$1" val="$2"
    if ! [[ "$val" =~ ^[0-9]+$ ]]; then
        echo "Option -$flag requires an unsigned integer, got: '$val'" 1>&2
        exit 1
    fi
}
while getopts ":gkqrxhHc:d:e:f:n:s:t:I:O:S:V:" opt; do
    case "$opt" in
        c) corrupt_indices_str="$OPTARG" ;;
        d) delete_indices_str="$OPTARG" ;;
        e) expected_file="expected/$OPTARG" ;;
        f) FORMAT="$OPTARG" ;;
        g) generate=1 ;;
        H) text_flag="" ;;
        h) usage ;;
        I) segid_indices_str="$OPTARG" ;;
        k) keep_tmp=1 ;;
        O) oversize_indices_str="$OPTARG" ;;
        n) require_uint n "$OPTARG"; number="$OPTARG" ;;
        q) verbose_flag="" ;;
        r) raw_dumphdr_enabled=1 ;;
        s) require_uint s "$OPTARG"; data_size="$OPTARG" ;;
        S) require_uint S "$OPTARG"; sessions="$OPTARG" ;;

        t) truncate_indices_str="$OPTARG" ;;
        V) version_indices_str="$OPTARG" ;;
        x) dumphdr_enabled=1 ;;
        :) echo "Option -$OPTARG requires an argument" 1>&2; usage ;;
        \?) echo "Unknown option: -$OPTARG" 1>&2; usage ;;
    esac
done
shift $((OPTIND - 1))

if [ -z "$expected_file" ]; then
    echo "The -e <expected-file> option is required." 1>&2
    usage
fi
# One form per file, so switching with -q does not ask for the other
# form's file to be regenerated first.
if [ -z "$verbose_flag" ]; then
    expected_file="${expected_file%.expected}-records.expected"
fi
if [ ! -f "$expected_file" ] && [ $generate -eq 0 ]; then
    echo "Expected results file not found: $expected_file" 1>&2
    echo "Use -g to create it from this run's output." 1>&2
    exit 1
fi

# Index lists accept unsigned integers and the word "last", which
# stands for the highest-numbered segment file. The count is not known
# until the log has been generated, so "last" is resolved after that.
check_indices() {
    local flag="$1"; shift
    local idx
    for idx in "$@"; do
        if ! [[ "$idx" =~ ^([0-9]+|last)$ ]]; then
            echo "Invalid index in -$flag list: '$idx' (must be an unsigned integer or 'last')" 1>&2
            exit 1
        fi
    done
}
read -r -a delete_indices <<< "$delete_indices_str"
read -r -a corrupt_indices <<< "$corrupt_indices_str"
read -r -a truncate_indices <<< "$truncate_indices_str"
read -r -a version_indices <<< "$version_indices_str"
read -r -a segid_indices <<< "$segid_indices_str"
read -r -a oversize_indices <<< "$oversize_indices_str"
check_indices d ${delete_indices[@]+"${delete_indices[@]}"}
check_indices c ${corrupt_indices[@]+"${corrupt_indices[@]}"}
check_indices t ${truncate_indices[@]+"${truncate_indices[@]}"}
check_indices V ${version_indices[@]+"${version_indices[@]}"}
check_indices I ${segid_indices[@]+"${segid_indices[@]}"}
check_indices O ${oversize_indices[@]+"${oversize_indices[@]}"}

# Maps "last" onto the real segment count and rejects an index that
# names no segment file, which would otherwise pass silently and leave
# the test asserting less than it looks like it does.
resolve_index() {
    local flag="$1" idx="$2" count="$3"
    if [ "$idx" = last ]; then
        echo "$count"
        return
    fi
    if [ "$idx" -lt 1 ] || [ "$idx" -gt "$count" ]; then
        echo "Index $idx in -$flag list is out of range: only $count segment file(s) exist" 1>&2
        exit 1
    fi
    echo "$idx"
}

rm_seg() {
    local idx=$1
    shift 1
    local args="$@"
    echo "Remove segment file #$idx: $args"
    rm $args
}

# Overwrites the eight-byte file-type magic so SegmentHeader::read_from
# rejects the segment. The file is still there and its neighbours'
# sequence numbers still step over it, so the reader sees the same
# sequence gap a deleted file would leave.
corrupt_seg() {
    local idx=$1 f=$2
    echo "Corrupt header magic of segment file #$idx: $f"
    printf '\0\0\0\0\0\0\0\0' |
        dd of="$f" bs=1 count=8 conv=notrunc status=none
}

# Cuts a segment's data section in half, leaving the header intact. The
# segment still opens and its sequence is still readable, so a record
# running off the short end is a truncation the sequence cannot explain
# -- the zero-lost case.
trunc_seg() {
    local idx=$1 f=$2
    local max_size hdr_len before data_len target
    max_size=$(od -An -tu4 -j28 -N4 "$f" | tr -d ' ')
    hdr_len=$((max_size - data_size))
    before=$(stat -c%s "$f")
    # Half of what this file actually holds, not half of the nominal
    # data section: a segment the writer short-rolled is shorter than
    # max_size, and `truncate -s` to a larger size would pad it with
    # zeros instead of cutting it -- damage of an entirely different
    # kind, silently substituted for the one the test asked for.
    data_len=$((before - hdr_len))
    if [ "$data_len" -lt 2 ]; then
        echo "Segment file #$idx holds $data_len data byte(s); -t has nothing to cut" 1>&2
        exit 1
    fi
    target=$((hdr_len + data_len / 2))
    echo "Truncate segment file #$idx from $before to $target bytes: $f"
    truncate -s "$target" "$f"
}

# Sets the four-byte version field to a major this build cannot read.
# The layout is two digits of major, one of minor, one of patch, and
# the reader requires an exact major match.
ver_seg() {
    local idx=$1 f=$2
    echo "Set unreadable version on segment file #$idx: $f"
    printf '9900' | dd of="$f" bs=1 seek=8 count=4 conv=notrunc status=none
}

# Flips a bit of the stored segment_id so it no longer matches the id
# the file name carries, which is what a renamed or copied segment file
# looks like. The reader must refuse it rather than trust the name.
segid_seg() {
    local idx=$1 f=$2
    local byte
    byte=$(od -An -tu1 -j12 -N1 "$f" | tr -d ' ')
    echo "Break stored segment_id of segment file #$idx: $f"
    printf "$(printf '\\%03o' $(((byte ^ 0xFF) & 0xFF)))" |
        dd of="$f" bs=1 seek=12 count=1 conv=notrunc status=none
}

# Pads a segment file past its own stored max_size. The spec requires a
# segment file to be no larger than the max_size in its header, so the
# reader must reject one that is.
oversize_seg() {
    local idx=$1 f=$2
    local max_size before
    max_size=$(od -An -tu4 -j28 -N4 "$f" | tr -d ' ')
    before=$(stat -c%s "$f")
    echo "Pad segment file #$idx from $before past its max_size of $max_size: $f"
    truncate -s $((max_size + 1)) "$f"
}

# Resolves an index list against the generated segment files and
# applies `action` to each, refusing an index whose file another action
# already removed.
apply_to_indices() {
    local flag="$1" action="$2"
    shift 2
    local num idx
    for num in "$@"; do
        num=$(resolve_index "$flag" "$num" "${#files[@]}")
        idx=$((num - 1))
        if [ ! -f "${files[$idx]}" ]; then
            echo "Segment file #$num is already gone; -$flag cannot act on it" 1>&2
            exit 1
        fi
        "$action" "$num" "${files[$idx]}"
    done
}

# Reject a --format this script does not know about before spending a
# cargo build on it; tcslog-gen validates the full syntax itself.
case $FORMAT in
    *fixed*|*variable-simple*|*variable-tsrc*)
        ;;

    *)
        echo "Invalid format: $FORMAT" 1>&2
        exit 1
        ;;
esac

echo "Generating log in $TMP_DIR: prefix $PFX suffix $SFX"

# Each pass writes its own session into the same directory, so -S
# builds a log the reader has to walk across session boundaries.
for pass in $(seq 1 "$sessions"); do
    if [ "$sessions" -gt 1 ]; then
        echo "-- session $pass of $sessions"
    fi
    cargo run -p tcslog-gen -- \
        --data-size $data_size \
        --format $FORMAT \
        --number $number \
        $TMP_DIR $PFX $SFX
done

declare -a files
files=($TMP_DIR/$PFX*$SFX)

if [ $raw_dumphdr_enabled -ne 0 ]; then
    echo
    echo "Hexdump of segment files before deletion"
    for f in "${files[@]}"; do
        echo
        echo $f
        dumphdr $f
    done
fi

if [ ${#delete_indices[@]} -gt 0 ]; then
    echo
    echo "Removing segment files"
    apply_to_indices d rm_seg "${delete_indices[@]}"
fi

if [ ${#corrupt_indices[@]} -gt 0 ]; then
    echo
    echo "Corrupting segment files"
    apply_to_indices c corrupt_seg "${corrupt_indices[@]}"
fi

if [ ${#truncate_indices[@]} -gt 0 ]; then
    echo
    echo "Truncating segment files"
    apply_to_indices t trunc_seg "${truncate_indices[@]}"
fi

if [ ${#version_indices[@]} -gt 0 ]; then
    echo
    echo "Setting unreadable versions"
    apply_to_indices V ver_seg "${version_indices[@]}"
fi

if [ ${#segid_indices[@]} -gt 0 ]; then
    echo
    echo "Breaking stored segment ids"
    apply_to_indices I segid_seg "${segid_indices[@]}"
fi

if [ ${#oversize_indices[@]} -gt 0 ]; then
    echo
    echo "Padding segment files past max_size"
    apply_to_indices O oversize_seg "${oversize_indices[@]}"
fi

if [ $dumphdr_enabled -ne 0 ]; then
    echo
    echo "Hexdump of segment files after deletion"
    for f in "${files[@]}"; do
        # One blank line ahead of each, as the dump before deletion
        # already does. Without it the files run together and the
        # header line of one reads as part of the one above.
        echo
        if [ -f $f ]; then
            echo $f:
            dumphdr $f
        else
            echo $f: deleted
        fi
    done
fi

echo
echo tcslog-dump output

actual_file=$(mktemp)
expected_cmp=$(mktemp)
actual_cmp=$(mktemp)

# One --verbose capture is the whole comparison. It carries the records,
# the per-segment header blocks, the truncation and overflow notices,
# the session markers and the totals, in the order the reader produced
# them, so the stored file fixes not just what each stream said but how
# the two interleave: which segment a record came from, which session a
# loss fell in, which record a notice follows.
#
# The header blocks were previously dropped as unreproducible. Only
# their two identifiers are: `max_size`, `remaining`, `format` and
# `sequence` are fixed by the log and the damage, and `remaining` and
# `sequence` are the fields the reader's own loss detection rests on.
# Discarding them left the suite unable to see a reader that computed
# either one wrongly unless the record set happened to change with it.
"$(dirname "$0")/tcslog-tool" tcslog-dump \
    "$TMP_DIR" "$PFX" "$SFX" ${verbose_flag:+"$verbose_flag"} \
    ${text_flag:+"$text_flag"} > "$actual_file"
cat "$actual_file"

# Segment identifiers are wall-clock timestamps, so neither they nor the
# file names built from them repeat. Replacing each with a label numbered
# in order of first appearance keeps them out of the comparison while
# still holding what they say: that two segments share a session, or that
# a later one opens a new session. Masking them all alike would discard
# exactly that.
#
# The variable-tsrc format stamps every record with the time it was
# written, which is likewise unrepeatable. Those get one label rather
# than numbered ones: whether two records share a timestamp depends on
# the clock's granularity, so numbering them would record a distinction
# that is not the reader's to make.
normalize() {
    sed 's/ts=[^,)]*/ts=<ts>/g' "$1" |
        awk '
            {
                id = "[0-9a-f][0-9a-f][0-9a-f][0-9a-f]"
                pat = id "-" id "-" id "-" id
                while (match($0, pat)) {
                    found = substr($0, RSTART, RLENGTH)
                    if (!(found in label)) {
                        label[found] = "<id" ++seen ">"
                    }
                    $0 = substr($0, 1, RSTART - 1) label[found] \
                        substr($0, RSTART + RLENGTH)
                }
                print
            }
        '
}

# Without --verbose the tool prints records and nothing else. Nothing in
# the stored file can show that, since the stored file is the verbose
# form, so assert it directly rather than leave the quiet mode uncovered.
check_quiet_mode() {
    local quiet
    quiet=$("$(dirname "$0")/tcslog-tool" tcslog-dump \
        "$TMP_DIR" "$PFX" "$SFX" ${text_flag:+"$text_flag"})
    if printf '%s\n' "$quiet" | grep -qE \
        '^(=== segment file:|    (segment_id|session_id|max_size|remaining|format|sequence):|    -- |    \(payload larger than|--- End of Session|read [0-9]+ message)'
    then
        echo "FAIL: output without --verbose is not records alone" 1>&2
        printf '%s\n' "$quiet" 1>&2
        return 1
    fi
    echo "OK: output without --verbose is records alone"
    return 0
}

if [ $generate -ne 0 ]; then
    normalize "$actual_file" > "$actual_cmp"
    cp "$actual_cmp" "$expected_file"
    echo
    echo "GENERATED: $expected_file (segment ids and timestamps labelled)"
    exit 0
fi

normalize "$expected_file" > "$expected_cmp"
normalize "$actual_file" > "$actual_cmp"

status=0
echo
if diff -u "$expected_cmp" "$actual_cmp"; then
    echo "OK: dump output matches $expected_file"
else
    echo "FAIL: dump output does not match $expected_file" 1>&2
    status=1
fi

check_quiet_mode || status=1
exit $status
