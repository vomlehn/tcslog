#!/bin/bash
#
# This runs tcslog-gen. It's helpful to verify that tcslog-gen is
# working correctly. It's also helpful in checking out tcslog-dump.

set -eu

# Cleanup runs from a single EXIT trap so that -k, which is not known
# until the options are parsed, can spare the segment files.
keep_tmp=0
TMP_DIR=$(mktemp -d -t tcslog.XXXXXXXXXX)
cleanup() {
    if [ $keep_tmp -ne 0 ]; then
        echo "Temporary directory kept: $TMP_DIR"
    else
        rm -rf "$TMP_DIR"
    fi
}
trap cleanup EXIT
PFX=pfx-
SFX=.log

usage() {
    echo "Usage: $0 [-k] [-h]" 1>&2
    echo "  -k  Print the temporary directory holding the segment" 1>&2
    echo "      files and keep it instead of deleting it on exit." 1>&2
    exit 1
}
while getopts ":kh" opt; do
    case "$opt" in
        k) keep_tmp=1 ;;
        h) usage ;;
        \?) echo "Unknown option: -$OPTARG" 1>&2; usage ;;
    esac
done
shift $((OPTIND - 1))

# Possible formats
#FORMAT="--format fixed:10"
FORMAT="--format variable-simple:10"
FORMAT="--format variable-simple:5..10"

cargo run -p tcslog-gen -- \
    --verbose \
    --data-size 5 \
    $FORMAT \
    --number 2  \
    $TMP_DIR $PFX $SFX

echo
echo Hexdump of segment files
for f in $TMP_DIR/$PFX*$SFX; do
    hexdump -C $f
done

echo
echo tcslog-dump output

cargo run -p tcslog-dump -- \
    --verbose \
    $TMP_DIR $PFX $SFX
