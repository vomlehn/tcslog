#!/bin/sh
# install-tools: installs what building, testing, checking, documenting and
# packaging tcslog needs, on a machine or in a container that has none of it.
#
#   bin/install-tools [--dry-run] [--no-packaging]
#
# It installs them with the system's own package manager, under sudo
# unless it is run as root, as in a container: apt-get on Debian, Ubuntu
# and what is like them, dnf on Fedora and Red Hat's, read from
# /etc/os-release. Rust comes from rustup, with the components the checks
# run: the rustup installed, or else, on Debian and Ubuntu, whose own Rust
# lags behind what the tools need, the system's rustup package, with the
# current stable toolchain. Fedora's own Rust keeps up, so it is used there.
# What the system does not package is installed for whoever runs this, with
# cargo install or pipx. --dry-run shows each command and runs none;
# --no-packaging leaves out the tools only `make packages` and `make
# lint-packages` need. `make install-tools` runs it, and DRY_RUN=1 and
# PACKAGING=0 there give the two.
#
# What it cannot install it says: a Rust or a Python too old, and the
# checkouts the checks need beside this one.

set -eu

# What tcslog needs. Building: C and C++ compilers for the C API's tests,
# cbindgen for its header, from crates.io, since the header must be what
# the current cbindgen writes and the systems' lag, and rst2html for the
# documents. make check:
# rustfmt, clippy, cargo-rdme, ruff and mypy; make test: hexdump. Python
# 3.11 because tcs-helpers' operational-names, which make check runs, reads
# TOML with tomllib. Ubuntu has no ruff package, so pipx installs it there.
PROJECT=tcslog
RUST_MIN=1.75
PYTHON_MIN=3.11
APT_BUILD="build-essential binutils python3 python3-pip python3-setuptools
	python3-docutils bsdextrautils mypy git"
DNF_BUILD="gcc gcc-c++ make binutils python3 python3-pip python3-setuptools
	python3-docutils util-linux ruff python3-mypy git"
APT_RUST="rustup"
DNF_RUST="cargo rust rustfmt clippy"
RUST_COMPONENTS="rustfmt clippy"
CARGO_TOOLS="cbindgen cargo-rdme"
PIPX_TOOLS="ruff"
CHECKOUTS="tcs-helpers tcslog-tools"
# The packaging tools: make packages and make lint-packages.
APT_PACKAGING="dpkg-dev rpm lintian rpmlint shellcheck gzip"
DNF_PACKAGING="dpkg dpkg-dev rpm-build lintian rpmlint ShellCheck gzip"

# The rest is the same in every TCS project that has this script; only what
# is above differs.

# Whether to show the commands rather than run them, and whether to install
# the packaging tools.
dry_run=0
packaging=1

# Prints how to call this command.
usage() {
	echo "usage: bin/install-tools [--dry-run] [--no-packaging]"
}

# Says what is being done, and does it unless this is a dry run.
#
# Arguments:
#   $@  The command and its arguments.
run() {
	echo "+ $*"
	[ "$dry_run" = 1 ] || "$@"
}

# Runs a command as root: as it is when this already is root, as in a
# container, and under sudo when not.
#
# Arguments:
#   $@  The command and its arguments.
as_root() {
	if [ "$(id -u)" = 0 ]; then
		run "$@"
	else
		run sudo "$@"
	fi
}

# Says whether one version is at least another.
#
# Arguments:
#   $1  The version there is, such as 1.93.1.
#   $2  The version it must be at least.
#
# Returns:
#   0 if $1 is $2 or later, 1 otherwise.
at_least() {
	[ "$(printf '%s\n%s\n' "$2" "$1" | sort -V | head -n 1)" = "$2" ]
}

# Gives the package manager this system uses, from its os-release file, or
# TCS_OS_RELEASE's: apt for Debian and Ubuntu and what is like them, dnf
# for Fedora and Red Hat's.
#
# Returns:
#   0, printing apt or dnf, or 1, saying why, for any other system.
manager() {
	release=${TCS_OS_RELEASE:-/etc/os-release}
	if [ ! -r "$release" ]; then
		echo "install-tools: no $release, so the system is not" \
			"known" >&2
		return 1
	fi
	ids=$(sed -n 's/^\(ID\|ID_LIKE\)=//p' "$release" | tr -d '"')
	for id in $ids; do
		case $id in
		debian | ubuntu)
			echo apt
			return 0
			;;
		fedora | rhel | centos)
			echo dnf
			return 0
			;;
		esac
	done
	echo "install-tools: $release names a system this does not know" \
		"($ids): install what README.md lists by hand" >&2
	return 1
}

while [ $# -gt 0 ]; do
	case $1 in
	--dry-run)
		dry_run=1
		;;
	--no-packaging)
		packaging=0
		;;
	-h | --help)
		usage
		exit 0
		;;
	*)
		usage >&2
		exit 2
		;;
	esac
	shift
done

kind=$(manager)
if [ "$kind" = apt ]; then
	packages="$APT_BUILD"
	[ "$packaging" = 0 ] || packages="$packages $APT_PACKAGING"
	[ -z "$PIPX_TOOLS" ] || packages="$packages pipx"
else
	packages="$DNF_BUILD"
	[ "$packaging" = 0 ] || packages="$packages $DNF_PACKAGING"
fi

# Rust from rustup, where it is, with the components the checks run; on
# Debian and Ubuntu the system's rustup package, and on Fedora its Rust.
if command -v rustup > /dev/null 2>&1; then
	use_rustup=1
elif [ "$kind" = apt ]; then
	use_rustup=1
	packages="$packages $APT_RUST"
else
	use_rustup=0
	packages="$packages $DNF_RUST"
fi

# shellcheck disable=SC2086 # the lists are words, split on purpose
if [ "$kind" = apt ]; then
	as_root apt-get update
	as_root apt-get install -y --no-install-recommends $packages
else
	as_root dnf install -y $packages
fi
if [ "$use_rustup" = 1 ]; then
	# A rustup just installed has no toolchain yet.
	if ! command -v rustup > /dev/null 2>&1 \
		|| ! rustup default > /dev/null 2>&1; then
		run rustup default stable
	fi
	# shellcheck disable=SC2086 # a list of words, split on purpose
	run rustup component add $RUST_COMPONENTS
fi

# What the system does not package, from crates.io and PyPI, for whoever
# ran this rather than root.
for tool in $CARGO_TOOLS; do
	if ! command -v "$tool" > /dev/null 2>&1; then
		run cargo install --locked "$tool"
	fi
done
if [ -n "$CARGO_TOOLS" ] && [ "$dry_run" = 0 ]; then
	case :$PATH: in
	*:"$HOME/.cargo/bin":*) ;;
	*)
		echo "install-tools: cargo installs in $HOME/.cargo/bin," \
			"which is not on PATH: add it, in ~/.profile"
		;;
	esac
fi
if [ "$kind" = apt ]; then
	for tool in $PIPX_TOOLS; do
		command -v "$tool" > /dev/null 2>&1 || run pipx install "$tool"
	done
fi

# What cannot be installed here, said rather than done.
[ "$dry_run" = 1 ] && exit 0
status=0
rust=$(rustc --version 2>/dev/null | awk '{print $2}')
if [ -z "$rust" ] || ! at_least "$rust" "$RUST_MIN"; then
	echo "install-tools: $PROJECT needs Rust $RUST_MIN or later, and" \
		"this has ${rust:-none}: install it with rustup" \
		"(https://rustup.rs)" >&2
	status=1
fi
python=$(python3 -c 'import sys; print("%d.%d" % sys.version_info[:2])')
if ! at_least "$python" "$PYTHON_MIN"; then
	echo "install-tools: $PROJECT needs Python $PYTHON_MIN or later," \
		"and this has $python" >&2
	status=1
fi
top=$(cd "$(dirname "$0")/.." && pwd)
for checkout in $CHECKOUTS; do
	if [ ! -d "$top/../$checkout" ]; then
		echo "install-tools: $PROJECT's checks need a checkout of" \
			"$checkout beside it: git clone" \
			"https://github.com/vomlehn/$checkout.git" \
			"$top/../$checkout"
	fi
done
[ "$status" = 0 ] && echo "[OK] The tools $PROJECT needs are installed"
exit "$status"
