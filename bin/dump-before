#!/bin/sh

# Dump a directory with log segment files. This is helpful when developing
# the tests in this directory.

set -eu

# The skip is SEGMENT_FILE_HEADER_LEN from tcslog::header; a smaller
# value would show the tail of the header as if it were payload.
dumpseg() {
    (
        if "$(dirname "$0")/tcslog-tool" tcslog-dumphdr "$@"; then
            if hexdump -C --skip 53 "$@"; then
                :
            else
                echo "Segment file data" "$@" "corrupted or missing"
            fi
        else
            :
        fi
    )
}

usage() {
    cat <<-EOF
Usage: $0 tmpdir
EOF
    exit 2
}

if [ $# -ne 1 ]; then
    usage
fi

tmpdir="$1"
sep=""
i=1

for f in $tmpdir/*; do
    printf "$sep"
    printf "#%d: %s\n" $i $f
    dumpseg $f
    sep="\\n"
    i=$((i + 1))
done

echo
num_files="$(ls $tmpdir/* | wc -l)"
echo "Number of files: $num_files"
