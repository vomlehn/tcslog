#!/bin/sh
# @PACKAGE@-links: links @PACKAGE@'s programs into /usr/local/bin.
#
#   @PACKAGE@-links [--remove] [--dir DIR]
#
# The packages put @PREFIX@/bin on PATH through /etc/profile.d, which only a
# login shell reads: sudo, cron and other minimal environments never see it.
# /usr/local/bin is on every one of those paths, sudo's secure_path
# included, and is the administrator's own, where the filesystem hierarchy
# standard (3.13) lets an administrator link the front ends of a package
# under /opt. So the administrator runs this, as root, when the programs are
# wanted everywhere; installing the package never does, because the choice
# is the administrator's. --dir names another directory, such as /opt/bin.
#
# The programs are this package's own, written in when it was installed, and
# not whatever is in @PREFIX@/bin: that directory is shared by every TCS
# package, and one package's links must never touch another's programs.
#
# Root is needed only because /usr/local/bin is root's, so it is not checked
# for: --dir pointing somewhere a user may write works for that user.
set -eu

PROGRAMS="@PROGRAMS@"
BIN="@PREFIX@/bin"

usage() {
	echo "usage: @PACKAGE@-links [--remove] [--dir DIR]"
	echo "  Links @PACKAGE@'s programs ($PROGRAMS)"
	echo "  into DIR, /usr/local/bin unless --dir says otherwise, as links"
	echo "  to $BIN; --remove takes away only those links."
}

remove=false
dir=/usr/local/bin
while [ $# -gt 0 ]; do
	case $1 in
	--remove)
		remove=true
		;;
	--dir)
		if [ $# -lt 2 ]; then
			usage >&2
			exit 2
		fi
		dir=$2
		shift
		;;
	--help)
		usage
		exit 0
		;;
	*)
		usage >&2
		exit 2
		;;
	esac
	shift
done

# Not made if it is missing: a directory that is not there is a typing
# mistake far more often than a wish for a new one, and a directory nobody
# has on PATH would hold links nothing finds.
if [ ! -d "$dir" ]; then
	echo "@PACKAGE@-links: $dir is missing: make it first, or name" \
	     "another with --dir" >&2
	exit 1
fi

status=0
for name in $PROGRAMS; do
	link=$dir/$name
	target=$BIN/$name
	if $remove; then
		# Only a link this made: a file or a link elsewhere is somebody
		# else's, and is left without a word.
		if [ -L "$link" ] && [ "$(readlink "$link")" = "$target" ]; then
			rm -f "$link"
		fi
		continue
	fi
	if [ -L "$link" ] && [ "$(readlink "$link")" = "$target" ]; then
		continue
	fi
	if [ -e "$link" ] || [ -L "$link" ]; then
		# Somebody else's, left alone. Said, and counted as a failure
		# once the rest are done, because the program of that name the
		# path finds is then not this package's.
		if [ -L "$link" ]; then
			what="a link to $(readlink "$link")"
		elif [ -d "$link" ]; then
			what="a directory"
		else
			what="a file"
		fi
		echo "@PACKAGE@-links: $link is $what, not a link to" \
		     "$target: left alone" >&2
		status=1
		continue
	fi
	ln -s "$target" "$link"
done
exit $status
